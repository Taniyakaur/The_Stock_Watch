# Copy this file to .env and fill in your values.
# Django's own secret (signs cookies). Generate one with:
#   python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
SECRET_KEY=change-me
DEBUG=1
ALLOWED_HOSTS=localhost,127.0.0.1
# Free key from https://finnhub.io (optional; Yahoo Finance is used without it)
FINNHUB_API_KEY=

# Alert emails. Leave EMAIL_HOST_USER empty to print emails in the terminal.
# For Gmail: turn on 2-Step Verification, then create an App Password at
# https://myaccount.google.com/apppasswords and paste it below (not your normal password).
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
# Link used in alert emails
SITE_URL=http://127.0.0.1:8000/
